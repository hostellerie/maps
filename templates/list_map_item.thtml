<article class="maps-list-card">
    <div class="maps-list-card-actions">{edit_button}</div>
    <h2 class="maps-list-card-title"><a href="{map_detail}">{name}</a></h2>
    <div class="maps-list-card-description">{description}</div>
    <div class="maps-list-card-meta">{update} {markers} {hits}</div>
</article>
