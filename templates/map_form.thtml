<div class="tabs maps-map-editor-tabs">
<ul class="tabNavigation">
<li><a href="#map_infos">{map_tab}</a></li>
<li><a href="#overlays">{overlays_tab}</a></li>
</ul>

<div id="map_infos" class="maps-map-editor-panel">
<form id="map_form" action="{site_admin_url}/plugins/maps/map_edit.php" enctype="multipart/form-data" method="POST">
{mid}
{csrf_token}

<fieldset><legend><b>{informations}</b></legend>
<div class="maps-form-grid">
<label class="maps-field maps-field-wide"><span>{name_label}<span class="maps-required">*</span></span><input type="text" name="name" value="{name}" maxlength="255" required></label>
<label class="maps-field maps-field-wide"><span>{description_label}</span><input type="text" name="description" value="{description}" maxlength="255"></label>
</div>
<p class="maps-help-text">{created_label} {created} · {modified_label} {modified}</p>
<p class="maps-help-text"><span class="maps-required">*</span> {required_field}</p>
</fieldset>

<fieldset><legend><b>{section_center}</b></legend>
<p class="maps-help-text">{center_help}</p>
<div class="maps-location-search maps-map-center-search">
<label class="maps-field maps-location-address"><span>{address_label}<span class="maps-required">*</span></span><input type="search" id="geo" name="geo" value="{geo}" maxlength="255" aria-label="{center_search_label}" required></label>
<div class="maps-location-buttons"><button type="button" id="maps-center-search">{center_search_button}</button>
<button type="button" id="maps-center-use">{center_use_button}</button></div>
</div>
<div id="maps-map-center-editor" class="maps-map-center-editor"></div>
<details class="maps-technical-coordinates">
<summary>{technical_coordinates}</summary>
<div class="maps-form-grid maps-form-grid-compact">
<label class="maps-field"><span>{latitude_label}</span><input type="text" id="map_center_lat" name="lat" value="{lat}" inputmode="decimal"></label>
<label class="maps-field"><span>{longitude_label}</span><input type="text" id="map_center_lng" name="lng" value="{lng}" inputmode="decimal"></label>
<label class="maps-field"><span>{map_zoom}</span><input type="number" id="zoom" name="zoom" value="{zoom}" min="0" max="22"></label>
<label class="maps-field"><span>{map_type}</span><select id="type" name="type">{options}</select></label>
</div>
</details>
</fieldset>

<fieldset><legend><b>{section_display}</b></legend>
<div class="maps-form-grid">
<label class="maps-field"><span>{map_width}</span><input type="text" id="width" name="width" value="{width}"></label>
<label class="maps-field"><span>{map_height}</span><input type="text" id="height" name="height" value="{height}"></label>
<label class="maps-field"><span>{active}</span><select name="active"><option value="0"{active_no}>{no}</option><option value="1"{active_yes}>{yes}</option></select></label>
<label class="maps-field"><span>{hidden}</span><select name="hidden"><option value="0"{hidden_no}>{no}</option><option value="1"{hidden_yes}>{yes}</option></select></label>
</div>
</fieldset>

<fieldset><legend><b>{section_markers}</b></legend>
<div class="maps-form-grid">
<label class="maps-field"><span>{free_marker}</span><select name="free_marker"><option value="0"{free_marker_no}>{no}</option><option value="1"{free_marker_yes}>{yes}</option></select></label>
<label class="maps-field"><span>{paid_marker}</span><select name="paid_marker"><option value="0"{paid_marker_no}>{no}</option><option value="1"{paid_marker_yes}>{yes}</option></select></label>
<label class="maps-field"><span>{mk_default}</span><select name="mk_default"><option value="0"{mk_default_no}>{no}</option><option value="1"{mk_default_yes}>{yes}</option></select></label>
</div>
<div class="maps-icon-choice">{icon}</div>
<div class="maps-form-grid maps-form-grid-compact">
<label class="maps-field"><span>{primary_color_label}</span><input type="color" id="primary_color" name="primary_color" value="{primary_color}"></label>
<label class="maps-field"><span>{stroke_color_label}</span><input type="color" id="stroke_color" name="stroke_color" value="{stroke_color}"></label>
<label class="maps-field"><span>{label_label}</span><input type="text" id="label" name="label" value="{label}" maxlength="1"></label>
<label class="maps-field"><span>{label_color_label}</span><select name="label_color"><option value="0"{label_color_black}>{black}</option><option value="1"{label_color_white}>{white}</option></select></label>
</div>
</fieldset>

<details class="maps-advanced-panel"><summary>{section_advanced}</summary>
<fieldset><legend>{header_footer}</legend>
<div class="maps-form-grid">
<label class="maps-field maps-field-wide"><span>{map_header_label}</span><textarea rows="7" id="mapheader" name="map_header">{map_header}</textarea></label>
<label class="maps-field maps-field-wide"><span>{map_footer_label}</span><textarea rows="7" id="mapfooter" name="map_footer">{map_footer}</textarea></label>
</div>
</fieldset>

<fieldset><legend>{lang_accessrights}</legend>
<div class="maps-form-grid">
<div class="maps-field"><span>{lang_owner}</span>{owner_select}</div>
<div class="maps-field"><span>{lang_group}</span>{group_dropdown}</div>
</div>
</fieldset>

<fieldset><legend>{lang_permissions}</legend>
<p>{lang_perm_key}</p>
<p>{permissions_editor}</p>
<p class="maps-help-text">{lang_permissions_msg}</p>
</fieldset>
</details>

<div class="maps-form-actions">
<button type="submit" name="mode" value="save">{save_button}</button>
{delete_action}
</div>
</form>
</div>

<div id="overlays" class="maps-map-editor-panel">
<div id="overlays_actions">
<div id="overlays_list">{overlays}</div>
<div id="add_overlay">{add_overlay}</div>
</div>
</div>
</div>
