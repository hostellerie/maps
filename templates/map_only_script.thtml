<style type="text/css">
#map_canvas_m{mid} {
    width: {map_width};
    height: {map_height};
}
#map_contener_m{mid} {
    width: {map_width};
    border: solid 1px #666;
    background: #ccc;
}
</style>

{markerclusterer}

<script type="text/javascript">
var map{mid};

function initialize{mid}() {
    var element = document.getElementById('map_canvas_m{mid}');
    if (!element || typeof google === 'undefined' || !google.maps) {
        return;
    }

    map{mid} = new google.maps.Map(element, {
        center: {lat: Number({lat}), lng: Number({lng})},
        zoom: Number({zoom}),
        mapTypeId: google.maps.MapTypeId.{map_type}
    });

    {markers}
}

if (window.addEventListener) {
    window.addEventListener('load', initialize{mid}, false);
} else {
    window.attachEvent('onload', initialize{mid});
}
</script>