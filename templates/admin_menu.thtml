<style type="text/css">
.maps-admin-menu { display:flex; flex-wrap:wrap; gap:.4rem .55rem; align-items:center; margin:0 0 1.1rem; padding:.65rem .75rem; border:1px solid rgba(127,127,127,.22); border-radius:10px; background:rgba(127,127,127,.045); }
.maps-admin-menu a { display:inline-block; padding:.4rem .6rem; border-radius:6px; text-decoration:none; }
.maps-admin-menu a:hover, .maps-admin-menu a:focus { background:rgba(127,127,127,.12); }
.maps-admin-menu form { display:none; }
.maps-admin-title { margin:.2rem 0 1rem; line-height:1.2; }
.maps-list-actions { margin:0 0 1rem; }
.maps-primary-action { font-weight:600; }
.maps-admin-geocoder { margin-bottom:1.5rem; }
.maps-geocoder-form { display:flex; flex-wrap:wrap; gap:.55rem; margin:1rem 0; }
.maps-geocoder-form input[type="text"] { flex:1 1 320px; min-width:0; box-sizing:border-box; padding:.65rem .75rem; font:inherit; }
.maps-geocoder-form button { padding:.65rem 1rem; font:inherit; cursor:pointer; }
.maps-geocoder-map { width:100%; height:400px; min-height:300px; border-radius:12px; overflow:hidden; background:#f2f2f2; }
.maps-visually-hidden { position:absolute!important; width:1px!important; height:1px!important; padding:0!important; margin:-1px!important; overflow:hidden!important; clip:rect(0,0,0,0)!important; white-space:nowrap!important; border:0!important; }
@media (max-width:680px) { .maps-admin-menu { align-items:stretch; } .maps-admin-menu a { flex:1 1 auto; text-align:center; } .maps-geocoder-map { height:320px; } }
</style>
<nav class="maps-admin-menu" aria-label="Maps administration">
 <a href="{site_url}/admin/plugins/maps/index.php">{admin_home}</a>
 <a href="{site_url}/admin/plugins/maps/markers.php">{markers}</a>
 <a href="{site_url}/admin/plugins/maps/icons.php">{icons}</a>
 <a href="{site_url}/admin/plugins/maps/overlays.php">{overlays}</a>
 <a href="{site_url}/admin/plugins/maps/import_export.php">{import_export}</a>
 <a href="{site_url}/admin/plugins/maps/geocoder.php">{geocoder}</a>
 <a href="{site_url}/admin/plugins/maps/index.php#maps-user-geolocation">{set_user_geo}</a>
 <a href="#" onclick="document.maps_conf_link.submit(); return false;">{configuration}</a>
 <form name="maps_conf_link" action="{site_admin_url}/configuration.php" method="POST">
  <input type="hidden" name="conf_group" value="maps">
 </form>
</nav>
