<style type="text/css">
#map_canvas{gid} {
    height: {map_height_geotag};
}
#map_contener{gid} {
    width: {map_width_geotag};
    border: solid 1px #666;
    background: #ccc;
}
#map_directions{gid} {
    border-top: solid 1px #666;
    display: {show_directions_geo};
    padding: 1px 5px;
}
</style>

<script type="text/javascript">
var map{gid};
var directionsDisplay{gid};
var current_address{gid} = '{address}';

function initializeGMap{gid}() {
    var element = document.getElementById('map_canvas{gid}');
    if (!element || typeof google === 'undefined' || !google.maps) {
        return;
    }

    map{gid} = new google.maps.Map(element, {
        center: {lat: Number({lat}), lng: Number({lng})},
        zoom: Number({zoom}),
        mapTypeId: google.maps.MapTypeId.{map_type}
    });

    new google.maps.Marker({
        position: {lat: Number({lat}), lng: Number({lng})},
        map: map{gid},
        title: '{address}'
    });

    directionsDisplay{gid} = new google.maps.DirectionsRenderer({
        map: map{gid},
        panel: document.getElementById('directions{gid}')
    });
}

if (window.addEventListener) {
    window.addEventListener('load', initializeGMap{gid}, false);
} else {
    window.attachEvent('onload', initializeGMap{gid});
}

function get_directions{gid}() {
    var input = document.getElementById('from_address{gid}');
    if (!input || !input.value) {
        alert('{error_address_empty}');
        return;
    }

    var service = new google.maps.DirectionsService();
    service.route({
        origin: input.value,
        destination: current_address{gid},
        travelMode: google.maps.TravelMode.DRIVING
    }, function (response, status) {
        if (status === 'OK' || status === google.maps.DirectionsStatus.OK) {
            directionsDisplay{gid}.setDirections(response);
            var anchor = document.getElementById('directions_{gid}_table');
            if (anchor && anchor.scrollIntoView) {
                anchor.scrollIntoView({behavior: 'smooth', block: 'start'});
            }
        } else {
            alert('{error_google_error} (' + status + ')');
        }
    });
}
</script>

<div id="map_contener{gid}">
    <div id="map_canvas{gid}"></div>
    <div id="map_directions{gid}">
        <small>&nbsp; {need_directions}<br />
            <input type="text" id="from_address{gid}" value="{value}" onfocus="if (this.value=='{value}')this.value='';" onblur="if(this.value=='')this.value='{value}';" size="30" style="width:200px;" />
            <input type="button" value="{get_directions}" onclick="get_directions{gid}();" />
        </small>
    </div>
</div>
<a id="directions_{gid}_table"></a>
<div id="directions{gid}"></div>