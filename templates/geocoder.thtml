<section class="maps-admin-geocoder">
    <h1 class="maps-admin-title">{geocoder}</h1>
    <p>{geocoder_text}</p>
    <div class="maps-geocoder-form">
        <label for="address" class="maps-visually-hidden">{geocoder}</label>
        <input type="text" id="address" value="1600 Amphitheatre Pky, Mountain View, CA">
        <button type="button" onclick="codeAddress()">{go}</button>
    </div>
    <div id="map_canvas" class="maps-geocoder-map"></div>
</section>
