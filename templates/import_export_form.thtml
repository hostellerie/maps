<script type="text/javascript">
(function () {
    function toggleAll(formId, source) {
        var form = document.getElementById(formId);
        if (!form) {
            return;
        }
        var boxes = form.querySelectorAll('input[name="import_export[]"]');
        for (var i = 0; i < boxes.length; i++) {
            boxes[i].checked = source.checked;
        }
    }
    window.MAPS_toggleImportFields = function (source) { toggleAll('maps-import-form', source); };
    window.MAPS_toggleExportFields = function (source) { toggleAll('maps-export-form', source); };
}());
</script>

<div id="import_form">
<form id="maps-import-form" action="{site_admin_url}/plugins/maps/import_export.php" method="post" enctype="multipart/form-data">
{csrf_token}
<fieldset style="margin-top:10px;padding:10px">
<legend><b>{import}</b></legend>
<p>{import_message}</p>
<p><b>{mid_label}</b> &nbsp;<select name="mid">{map_options}</select></p>
<p><b>{select_file}</b> <input type="file" name="file" accept=".csv,text/csv" required></p>
<p><b>{separator_in}</b> &nbsp;<select name="separator_in">{separator_options_in}</select></p>
<p><b>{choose_fields_import}</b></p>
<p>{fields_selector}</p>
<p><label><input type="checkbox" onclick="MAPS_toggleImportFields(this)"> {checkall}</label></p>
<input type="hidden" name="mode" value="import">
<p><input type="submit" name="submit" value="{import}"></p>
</fieldset>
</form>
</div>

<div id="export_form">
<form id="maps-export-form" action="{site_admin_url}/plugins/maps/import_export.php" method="post">
{csrf_token}
<fieldset style="margin-top:10px;padding:10px">
<legend><b>{export}</b></legend>
<p>{export_message}</p>
<p><b>{mid_label}</b> &nbsp;<select name="mid">{map_options}</select></p>
<p><b>{separator_out}</b> &nbsp;<select name="separator_out">{separator_options_out}</select></p>
<p><b>{choose_fields_export}</b></p>
<p>{fields_selector}</p>
<p><label><input type="checkbox" onclick="MAPS_toggleExportFields(this)"> {checkall}</label></p>
<input type="hidden" name="mode" value="export">
<p><input type="submit" name="submit" value="{export}"></p>
</fieldset>
</form>
</div>
