<div class="maps-location-editor">
	<form action="#" onsubmit="codeAddress(); return false">
	  <label for="geoaddress"><strong>{location_search_label}</strong></label>
	  <div class="maps-location-search">
		<input type="search" id="geoaddress" name="geoaddress" value="{default_address}" oninput="copyText()" />
		<button type="submit" onfocus="copyText();">{go}</button>
	  </div>
	  <p class="maps-help-text">{location_search_help}</p>
	  <div id="map_contener_submission">
	    <div id="map_canvas" style="width: {marker_editor_width}; height: {marker_editor_height}"></div>
	    <p class="maps-help-text">{use_map_click_help}</p>
	    <div id="submission_presentation"></div>
	  </div>
	</form>
</div>
&nbsp;
<div id="marker_form">
	<form name="marker_edit" action="{site_url}/admin/plugins/maps/marker_edit.php" method="POST">
        {csrf_token}
		<fieldset style="margin-top: 10px;padding:10px;">
		<legend><a class="maps-section-toggle" onClick="elementToggle('informations'); return false;" href="#"><b>{section_location}</b></a></legend>
			<div id="informations">
				<p><b>{name_label}</b><font color="red">*</font> <input type="text" name="name" value="{name}" size="80" maxlength="255"></p>
				<p><b>{address_label}</b><font color="red">*</font> <input type="text" id="address" name="address" value="{address}" size="80" maxlength="255"></p>
				<details class="maps-technical-coordinates">
					<summary>{technical_coordinates}</summary>
					<p><b>{lat}</b> <input type="text" id="lat" name="lat" value="{lat_value}" size="14" maxlength="20">&nbsp;&nbsp;
					<b>{lng}</b> <input type="text" id="lng" name="lng" value="{lng_value}" size="14" maxlength="20"><br{xhtml}>
					{empty_for_geo}</p>
				</details>
				<p><b>{mid_label}</b> &nbsp;<select id="mid" name="mid">{map_options}</select><br{xhtml}>
				{select_marker_map}</p>
				<p><small>{created_label} {created}<br{xhtml}>{modified_label} {modified}</small></p>
			</div>
		</fieldset>	
        <fieldset style="margin-top: 10px;"><legend><a class="maps-section-toggle" onClick="elementToggle('marker_label'); return false;" href="#"><b>{section_appearance}</b></a></legend>
			<div id="marker_label"  style="display:none;">
				<p>{mk_default} <select name="mk_default">
				<option value="0"{mk_default_no}>{no}</option>
				<option value="1"{mk_default_yes}>{yes}</option>
				</select></p>
				{marker_icon}
				<p>{primary_color_label} <input type="color" name="primary_color" value="{primary_color}" /></p>
				<p>{stroke_color_label} <input type="color" name="stroke_color" value="{stroke_color}" /></p>
				<p>{label_label} <input type="text" name="label" value="{label}" size="2" maxlength="1" /></p>
				<p>{label_color_label} <select name="label_color">
				<option value="0"{label_color_black}>{black}</option>
				<option value="1"{label_color_white}>{white}</option>
				</select></p>
			</div>
		</fieldset>
		<fieldset style="margin-top: 10px;">
		<legend><b><a class="maps-section-toggle" onClick="elementToggle('publication'); return false;" href="#">{section_publication}</a></b></legend>
			<div id="publication" style="display:none;">
				<p>{active} <select name="active">
				<option value="0"{active_no}>{no}</option>
				<option value="1"{active_yes}>{yes}</option>
				</select></p>
				<p>{hidden} <select name="hidden">
				<option value="0"{hidden_no}>{no}</option>
				<option value="1"{hidden_yes}>{yes}</option>
				</select></p>
				<p>{payed} <select name="payed">
				<option value="0"{payed_no}>{no}</option>
				<option value="1"{payed_yes}>{yes}</option>
				</select></p>
				<p>{marker_validity} <select id="validity" name="validity" onchange="changeValidity();">
				<option value="0"{validity_no}>{no}</option>
				<option value="1"{validity_yes}>{yes}</option>
				</select></p>
				<p>{from_label} <input type="text" name="from" id="from" value="{from}"{disabled} />
				{to_label} <input type="text" name="to" id="to" value="{to}"{disabled} /></p>
				<p>{remark_label}<br{xhtml}><textarea name="remark" rows="4" cols="80">{remark}</textarea></p>
			</div>
		</fieldset>
		<fieldset style="margin-top: 10px;">
		<legend><b><a class="maps-section-toggle" onClick="elementToggle('presentation'); return false;" href="#">{section_content_contact}</a></b></legend>
			<div id="presentation" style="display:none;">
				<p>{description_label}<br{xhtml}><textarea name="description" rows="8" cols="80">{description}</textarea></p>
				<p>{street_label} {street}</p>
				<p>{code_label} {code}</p>
				<p>{city_label} {city}</p>
				<p>{state_label} {state}</p>
				<p>{country_label} {country}</p>
				<p>{tel_label} {tel}</p>
				<p>{fax_label} {fax}</p>
				<p>{web_label} {web}</p>
			</div>
		</fieldset>
		<fieldset style="margin-top: 10px;">
		<legend><b><a class="maps-section-toggle" onClick="elementToggle('ressources'); return false;" href="#">{section_resources}</a></b></legend>
			<div id="ressources" style="display:none;">
				{ressources}
			</div>
		</fieldset>
		<fieldset style="margin-top: 10px;">
		<legend><b><a class="maps-section-toggle" onClick="elementToggle('lang_accessrights'); return false;" href="#">{section_ownership}</a></b></legend>
			<div id="lang_accessrights" style="display:none;">
				<!--<div><p>{lang_owner}: {owner_name}<input type="hidden" name="owner_id" value="{owner_id}"{xhtml}></p></div>-->
				<div>{lang_owner}: {owner_select}</div>
				<div><p>{lang_group}: {group_dropdown}</p></div>
			</div>
		</fieldset>
		<fieldset style="margin-top: 10px;">
		<legend><b><a class="maps-section-toggle" onClick="elementToggle('lang_permissions'); return false;" href="#">{section_permissions}</a></b></legend>
			<div id="lang_permissions" style="display:none;">
				<p>{lang_perm_key}</p>
				<p>{permissions_editor}</p>
				<p>{lang_permissions_msg}</p>
			</div>
		</fieldset>
		<p><font color="red"><strong><small>*</font> {required_field}</small></strong></p>
		<div class="maps-form-actions">
			<input type="hidden" name="submission" value="{submission}">
			<button type="submit" name="mode" value="save">{save_button}</button>
			<button type="submit" name="mode" value="delete" class="maps-danger-action maps-delete-marker">{delete_button}</button>
			{mkid}
		</div>
	</form>
</div>